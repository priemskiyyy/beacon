{
  "name": "@priemskiyyy/beacon-http",
  "version": "0.1.0",
  "description": "Your own release manifest endpoint as a Beacon release source: your client owns transport, authentication and validation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/adapters/http"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "homepage": "https://priemskiyyy.github.io/beacon/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project http"
  },
  "peerDependencies": {
    "@priemskiyyy/beacon": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/beacon": "workspace:*"
  },
  "keywords": [
    "http",
    "fetch",
    "manifest",
    "etag",
    "release",
    "update",
    "typescript",
    "beacon",
    "adapter"
  ]
}
