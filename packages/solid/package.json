{
  "name": "@priemskiyyy/beacon-solid",
  "version": "0.1.0",
  "description": "Solid bindings for Beacon: a provider, and primitives that read route state and what is running without starting anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project solid --project solid-ssr --project solid-hydration"
  },
  "peerDependencies": {
    "@priemskiyyy/beacon": ">=0.1.0 <0.2",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@priemskiyyy/beacon": "workspace:*"
  },
  "keywords": [
    "solid",
    "solidjs",
    "primitives",
    "release",
    "update",
    "typescript",
    "beacon"
  ],
  "homepage": "https://priemskiyyy.github.io/beacon/"
}
