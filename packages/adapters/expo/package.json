{
  "name": "@priemskiyyy/beacon-expo",
  "version": "0.1.0",
  "description": "Expo Updates as a Beacon route, and the installed native build as a running reader: checks, downloads and reloads delegated to expo-updates, with results mapped in full and nothing claimed as running until a later boot shows it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/adapters/expo"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "homepage": "https://priemskiyyy.github.io/beacon/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js",
      "default": "./dist/mock.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project expo"
  },
  "peerDependencies": {
    "@priemskiyyy/beacon": ">=0.1.0 <0.2",
    "expo-application": ">=5.0.0",
    "expo-updates": ">=0.24.0"
  },
  "devDependencies": {
    "@priemskiyyy/beacon": "workspace:*",
    "@priemskiyyy/beacon-app-store": "workspace:*",
    "@priemskiyyy/beacon-google-play": "workspace:*"
  },
  "keywords": [
    "expo",
    "expo-updates",
    "expo-application",
    "eas-update",
    "ota",
    "react-native",
    "version-code",
    "build-number",
    "release",
    "typescript",
    "beacon",
    "adapter"
  ],
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    }
  }
}
