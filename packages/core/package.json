{
  "name": "@priemskiyyy/beacon",
  "version": "0.1.0",
  "description": "Typed, reactive release awareness and update coordination: what an application is running, what its release authorities want, and which provider actions can be requested, without claiming an installation nobody observed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "homepage": "https://priemskiyyy.github.io/beacon/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./versions": {
      "types": "./dist/versions.d.ts",
      "import": "./dist/versions.js",
      "default": "./dist/versions.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js",
      "default": "./dist/mock.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./triggers": {
      "types": "./dist/triggers.d.ts",
      "import": "./dist/triggers.js",
      "default": "./dist/triggers.js"
    },
    "./triggers/browser": {
      "types": "./dist/triggers-browser.d.ts",
      "import": "./dist/triggers-browser.js",
      "default": "./dist/triggers-browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project core"
  },
  "keywords": [
    "release",
    "update",
    "ota",
    "app-store",
    "service-worker",
    "expo-updates",
    "version-check",
    "force-update",
    "check-on-foreground",
    "typescript",
    "react-native",
    "beacon"
  ],
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
