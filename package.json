{
  "name": "beacon-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm test:scenarios && pnpm test:limits && pnpm test:package && pnpm test:size && pnpm verify:docs && pnpm verify:snippets && pnpm verify:jsdoc && pnpm lint:prettier && pnpm test:unit",
    "test:scenarios": "node scripts/verify-scenarios.mjs",
    "test:package": "node scripts/verify-packages.mjs",
    "test:limits": "node scripts/verify-limits.mjs",
    "test:size": "node scripts/measure-size.mjs",
    "test:mutation": "node scripts/mutate.mjs",
    "test:browser": "pnpm build && playwright test -c examples/playwright.config.ts",
    "build:docs": "vitepress build docs",
    "dev:docs": "vitepress dev docs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "verify:jsdoc": "node scripts/verify-jsdoc.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@appzung/react-native-code-push": "11.0.5",
    "@bravemobile/react-native-code-push": "13.3.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@priemskiyyy/pulse": "0.1.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/remote-config": "26.4.0",
    "@revopush/react-native-code-push": "2.6.2",
    "@react-native-community/netinfo": "12.0.1",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/jsdom": "27.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "4.1.10",
    "async-storage-v2": "npm:@react-native-async-storage/async-storage@2.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "expo-application": "57.0.3",
    "expo-constants": "57.0.19",
    "expo-sqlite": "57.0.3",
    "expo-updates": "57.0.24",
    "fast-check": "4.10.2",
    "firebase": "12.19.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-device-info": "15.0.2",
    "react-native-mmkv": "4.3.2",
    "react-native-mmkv-v3": "npm:react-native-mmkv@3.3.3",
    "react-native-nitro-modules": "0.37.1",
    "react-native-code-push": "9.0.1",
    "rolldown": "1.2.11",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42"
  }
}
