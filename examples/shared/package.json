{
  "name": "example-shared",
  "private": true,
  "type": "module",
  "description": "The code the example apps share: the release lab, the styles and the formatting.",
  "exports": {
    "./lab/*": "./lab/*.ts",
    "./formatting/*": "./formatting/*.ts",
    "./types/*": "./types/*.ts",
    "./utils/*": "./utils/*.ts",
    "./ui/theme.css": "./ui/theme.css",
    "./ui/constants/*": "./ui/constants/*.ts",
    "./ui/styles/*": "./ui/styles/*.ts",
    "./ui/types/*": "./ui/types/*.ts"
  },
  "scripts": {
    "lint:typescript": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@priemskiyyy/beacon": "workspace:*",
    "class-variance-authority": "0.7.1",
    "ts-pattern": "5.9.0"
  }
}
