{
  "name": "@priemskiyyy/beacon-device-info",
  "version": "0.1.0",
  "description": "The installed native build as a Beacon running reader, from react-native-device-info, named the way the store adapters name their releases.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/adapters/device-info"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project device-info"
  },
  "peerDependencies": {
    "@priemskiyyy/beacon": ">=0.1.0 <0.2",
    "react-native-device-info": ">=10.0.0"
  },
  "devDependencies": {
    "@priemskiyyy/beacon": "workspace:*"
  },
  "keywords": [
    "native",
    "react-native",
    "react-native-device-info",
    "version-code",
    "build-number",
    "release",
    "typescript",
    "beacon",
    "adapter"
  ],
  "peerDependenciesMeta": {
    "react-native-device-info": {
      "optional": true
    }
  }
}
