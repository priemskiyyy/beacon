{
  "name": "beacon-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm test:scenarios && pnpm test:limits && pnpm test:package && pnpm test:size && pnpm lint:prettier && pnpm test:unit",
    "test:scenarios": "node scripts/verify-scenarios.mjs",
    "test:package": "node scripts/verify-packages.mjs",
    "test:limits": "node scripts/verify-limits.mjs",
    "test:size": "node scripts/measure-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-updates": "57.0.24",
    "fast-check": "4.10.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "rolldown": "1.2.11",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.10"
  }
}
