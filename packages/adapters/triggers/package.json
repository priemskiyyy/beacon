{
  "name": "@priemskiyyy/beacon-triggers",
  "version": "0.1.0",
  "description": "Checks a Beacon on the moments an app needs it: startup, a return from the background, a network that came back, an interval and a push, through one gate that shares reads, backs off after a failure and subscribes to nothing before you ask.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/adapters/triggers"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project triggers"
  },
  "peerDependencies": {
    "@priemskiyyy/beacon": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/beacon": "workspace:*"
  },
  "keywords": [
    "react-native",
    "appstate",
    "netinfo",
    "foreground",
    "reconnect",
    "polling",
    "backoff",
    "release",
    "typescript",
    "beacon",
    "adapter"
  ]
}
