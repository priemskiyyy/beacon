{
  "name": "example-expo",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:native": "expo export --platform ios --platform android --output-dir ../../.artifacts/expo-native",
    "lint:typescript": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@priemskiyyy/beacon": "workspace:*",
    "@priemskiyyy/beacon-expo": "workspace:*",
    "@priemskiyyy/beacon-native": "workspace:*",
    "@priemskiyyy/beacon-react": "workspace:*",
    "example-shared": "workspace:*",
    "expo": "57.0.24",
    "expo-application": "57.0.3",
    "expo-sqlite": "57.0.3",
    "expo-updates": "57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.8.3"
  }
}
