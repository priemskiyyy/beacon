{
  "name": "@priemskiyyy/beacon-react",
  "version": "0.1.0",
  "description": "React bindings for Beacon: hooks that read route state and what is running without starting anything, and a provider that can hold the observation session.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/beacon.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/beacon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project react"
  },
  "peerDependencies": {
    "@priemskiyyy/beacon": ">=0.1.0 <0.2",
    "react": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@priemskiyyy/beacon": "workspace:*",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.2.8"
  },
  "keywords": [
    "react",
    "hooks",
    "release",
    "update",
    "typescript",
    "beacon"
  ],
  "homepage": "https://priemskiyyy.github.io/beacon/"
}
