{
  "name": "beacon-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:unit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.2",
    "eslint": "9.39.4",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.10"
  }
}
